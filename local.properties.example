# Copy this file to local.properties for repository-local settings.
# This file should stay private and must not be committed.

# Shared secret used by both ClawApp and ClawRuntime packaging scripts.
# Leave this commented out to generate a 64-character random hex secret, or set
# at least 32 hexadecimal characters. Empty values and placeholders are rejected.
# Generate/synchronize from the repository root:
#   pwsh -File ClawRuntime/scripts/sync-shared-secret.ps1
# clawdroid.runtime.sharedSecret=

# Optional but recommended for release packages.
# Comma-separated SHA256 signature digests accepted by ClawRuntime.
# Include both release and debug certificate digests so either variant can connect.
# Compute via: keytool -list -v -keystore <jks> -alias <alias> | findstr SHA256:
# Then lowercase, strip colons, prefix with "sha256:".
# Example (each digest must contain exactly 64 hexadecimal characters):
# clawdroid.runtime.allowedSignatures=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Release APK signing keystore (required for every release build).
# Path, store password, and alias must all be configured; key password defaults
# to the store password when omitted. Release tasks fail if configuration is
# incomplete or the keystore file is missing. Debug builds do not require it.
# Path is relative to ClawApp/ (the Gradle rootDir).
# See ClawApp/keystore/README.md for setup instructions.
# clawdroid.keystore.path=keystore/clawdroid-release.jks
# clawdroid.keystore.password=<keystore-password>
# clawdroid.keystore.alias=clawdroid-release
# clawdroid.keystore.key.password=<key-password>
